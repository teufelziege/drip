#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
bin/build
python3 tests/test_counter.py
omarchy plugin validate plugin
python3 - <<'PY'
from pathlib import Path
from datetime import datetime
import shutil, json
home=Path.home()
target=home/'.config/omarchy/plugins/tlindsey.drip'
target.mkdir(parents=True,exist_ok=True)
shutil.copytree('plugin',target,dirs_exist_ok=True)
shutil.copy2('build/drip',target/'drip.new')
(target/'drip.new').replace(target/'drip')
p=home/'.config/omarchy/shell.json'
s=json.loads(p.read_text())
p.with_name('shell.json.bak.drip.'+datetime.now().strftime('%Y%m%d-%H%M%S')).write_text(p.read_text())
layout=s.setdefault('bar',{}).setdefault('layout',{})
if not any(e.get('id')=='tlindsey.drip' for entries in layout.values() if isinstance(entries,list) for e in entries):
    layout.setdefault('centerBegin',[]).append({'id':'tlindsey.drip'})
temporary=p.with_name('shell.json.drip.tmp')
temporary.write_text(json.dumps(s,indent=2)+'\n')
temporary.replace(p)
PY
omarchy-shell shell rescanPlugins
printf 'Drip installed. If updating, run: omarchy restart shell\n'
